// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum StatusLead {
  NOVO
  PRIMEIRO_CONTATO
  DOCUMENTACAO
  DIGITACAO
  EM_ANALISE
  APROVADO
  PAGO
  PERDIDO
}

enum TipoHistoricoLead {
  LEAD_CRIADO

  LIGACAO
  WHATSAPP
  EMAIL
  PRESENCIAL

  DOCUMENTACAO
  DIGITACAO
  ANALISE

  CONTRATO_PAGO
  LEAD_PERDIDO

  STATUS_ALTERADO
  BANCO_ALTERADO
  CONVENIO_ALTERADO
  PRODUTO_ALTERADO
  VENDEDOR_ALTERADO

  PROXIMO_CONTATO_ALTERADO
  PROPOSTA_ALTERADA
  CONTRATO_ALTERADO
}

enum StatusProposta {
  RASCUNHO
  EM_ANALISE
  APROVADA
  REPROVADA
  PAGA
  CANCELADA
}

enum StatusContrato {
  RASCUNHO
  DIGITADO
  EM_ANALISE
  APROVADO
  PAGO
  CANCELADO
}

model Cliente {
  id       Int     @id @default(autoincrement())
  nome     String
  cpf      String  @unique
  telefone String
  email    String?

  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  estado      String?

  leadId Int?  @unique
  lead   Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  criadoEm DateTime @default(now())
}

model Vendedor {
  id             Int       @id @default(autoincrement())
  nome           String
  cpf            String    @unique
  rg             String?
  dataNascimento DateTime?
  telefone       String
  whatsapp       String?
  email          String?
  matricula      String?   @unique
  cargo          String    @default("Vendedor")
  dataAdmissao   DateTime?
  situacao       String    @default("ATIVO")
  metaMensal     Decimal   @default(0)
  metaContratos  Int       @default(0)
  comissaoPadrao Decimal   @default(0)
  observacoes    String?
  criadoEm       DateTime  @default(now())
  atualizadoEm   DateTime  @updatedAt

  leads        Lead[]
  propostas    Proposta[]
  contratos    Contrato[]
  metasMensais MetaMensalVendedor[]
}

model Banco {
  id     Int     @id @default(autoincrement())
  nome   String  @unique
  codigo String?
  ativo  Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  leads     Lead[]
  propostas Proposta[]
  contratos Contrato[]
}

model Convenio {
  id     Int     @id @default(autoincrement())
  nome   String  @unique
  codigo String?
  ativo  Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  leads     Lead[]
  propostas Proposta[]
  contratos Contrato[]
}

model Produto {
  id     Int     @id @default(autoincrement())
  nome   String  @unique
  codigo String?
  ativo  Boolean @default(true)

  comissaoPercentual Decimal @default(0)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  leads     Lead[]
  propostas Proposta[]
  contratos Contrato[]
}

model Lead {
  id Int @id @default(autoincrement())

  nome        String
  cpf         String?
  telefone    String
  whatsapp    String?
  email       String?
  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  estado      String?

  origem String     @default("WhatsApp")
  status StatusLead @default(NOVO)

  // Campo antigo mantido temporariamente para preservar dados existentes.
  convenio String?

  convenioId       Int?
  convenioCadastro Convenio? @relation(fields: [convenioId], references: [id])

  // Campo antigo mantido temporariamente para preservar dados existentes.
  banco String?

  bancoId       Int?
  bancoCadastro Banco? @relation(fields: [bancoId], references: [id])

  // Campo antigo mantido temporariamente para preservar dados existentes.
  produto String?

  produtoId       Int?
  produtoCadastro Produto? @relation(fields: [produtoId], references: [id])

  valorSolicitado Decimal? @default(0)
  valorLiberado   Decimal? @default(0)

  observacoes    String?
  proximoContato DateTime?
  ultimoContato  DateTime?

  vendedorId Int?
  vendedor   Vendedor? @relation(fields: [vendedorId], references: [id])

  historicos   HistoricoLead[]
  propostas    Proposta[]
  criadoEm     DateTime        @default(now())
  atualizadoEm DateTime        @updatedAt
  contratos    Contrato[]
  cliente      Cliente?
}

model HistoricoLead {
  id Int @id @default(autoincrement())

  tipo      TipoHistoricoLead
  descricao String

  valorAnterior String?
  valorNovo     String?

  leadId Int
  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  criadoEm DateTime @default(now())
}

model Proposta {
  id Int @id @default(autoincrement())

  status StatusProposta @default(RASCUNHO)

  valorSolicitado Decimal @default(0)
  valorAprovado   Decimal @default(0)

  prazo        Int?
  valorParcela Decimal?
  taxa         Decimal?

  observacoes String?

  leadId Int
  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  bancoId Int?
  banco   Banco? @relation(fields: [bancoId], references: [id])

  convenioId Int?
  convenio   Convenio? @relation(fields: [convenioId], references: [id])

  produtoId Int?
  produto   Produto? @relation(fields: [produtoId], references: [id])

  vendedorId Int?
  vendedor   Vendedor? @relation(fields: [vendedorId], references: [id])

  criadoEm     DateTime   @default(now())
  atualizadoEm DateTime   @updatedAt
  contratos    Contrato[]
}

model Contrato {
  id Int @id @default(autoincrement())

  numero String? @unique

  status StatusContrato @default(RASCUNHO)

  valorContratado Decimal @default(0)
  valorLiberado   Decimal @default(0)

  prazo        Int?
  valorParcela Decimal?
  taxa         Decimal?

  dataDigitacao      DateTime?
  dataAprovacao      DateTime?
  dataPagamento      DateTime?
  comissaoPaga       Boolean   @default(false)
  dataComissaoPaga   DateTime?
  comissaoPercentual Decimal   @default(0)
  valorComissao      Decimal   @default(0)

  observacoes String?

  propostaId Int
  proposta   Proposta @relation(fields: [propostaId], references: [id], onDelete: Cascade)

  leadId Int
  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  bancoId Int?
  banco   Banco? @relation(fields: [bancoId], references: [id])

  convenioId Int?
  convenio   Convenio? @relation(fields: [convenioId], references: [id])

  produtoId Int?
  produto   Produto? @relation(fields: [produtoId], references: [id])

  vendedorId Int?
  vendedor   Vendedor? @relation(fields: [vendedorId], references: [id])

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model MetaMensalVendedor {
  id Int @id @default(autoincrement())

  ano Int
  mes Int

  metaValor     Decimal @default(0)
  metaContratos Int     @default(0)

  vendedorId Int
  vendedor   Vendedor @relation(fields: [vendedorId], references: [id], onDelete: Cascade)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([vendedorId, ano, mes])
}
